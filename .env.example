# Capital Quest Environment Variables (Example)
# DO NOT COMMIT SECRETS OR SERVICE ROLE KEYS TO VERSION CONTROL

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Public Configuration (Phase 2)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Server-Only Supabase Service Role Key (Phase 2 - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="your-server-service-role-key-here"

# Event Configuration Defaults
NEXT_PUBLIC_DEFAULT_EVENT_NAME="Capital Quest 2026"
NEXT_PUBLIC_STARTING_CAPITAL="1000000.00"
NEXT_PUBLIC_STARTING_VALUATION="200000.00"
